<Window x:Class="SignalGenerator.App.MainWindow"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SignalGenerator.App"
        mc:Ignorable="d"
        Title="MainWindow" Height="740" Width="1040">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>

        <ScottPlot:WpfPlot x:Name="WpfPlot1" />
        <DockPanel Grid.Column="1" LastChildFill="False">
            <!-- Общие параметры дискретизации -->
            <StackPanel DockPanel.Dock="Top" Height="45" Orientation="Horizontal">
                <Label Content="Длина(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="len_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="5" Margin="10,10,0,0"
                         Height="20" Width="50"/>
                <Label Content="Частота(Гц)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="freq_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="10" Margin="10,10,0,0"
                         Height="20" Width="50"/>
            </StackPanel>

            <!-- Выбор типа сигнала и кнопка генерации -->
            <StackPanel DockPanel.Dock="Top" Height="45" Orientation="Horizontal">
                <Label Content="Тип сигнала" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <ComboBox x:Name="SignalTypeComboBox" Width="100" Height="22" Margin="10,8,0,0"
                          VerticalAlignment="Top" SelectionChanged="SignalTypeComboBox_SelectionChanged"/>
                <Button Content="Сгенерировать" Width="100" Height="22" Margin="10,8,0,0"
                        VerticalAlignment="Top" Click="Button_Click_Generate"/>
            </StackPanel>

            <!-- Панель параметров: Синусоида -->
            <StackPanel x:Name="SinePanel" DockPanel.Dock="Top" Orientation="Vertical" Visibility="Visible">
                <StackPanel Height="38" Orientation="Horizontal">
                    <Label Content="Период(с)" VerticalAlignment="Top" Margin="10,8,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="period_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="2" Margin="10,8,0,0"
                             Height="20" Width="50"/>
                    <Label Content="Фаза(с)" VerticalAlignment="Top" Margin="10,8,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="phase_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="0" Margin="10,8,0,0"
                             Height="20" Width="50"/>
                </StackPanel>
                <StackPanel Height="38" Orientation="Horizontal">
                    <Label Content="Амплитуда" VerticalAlignment="Top" Margin="10,8,0,0" Padding="0,0,0,0" />
                    <TextBox x:Name="scale_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="1" Margin="10,8,0,0"
                             Height="20" Width="50"/>
                </StackPanel>
            </StackPanel>

            <!-- Панель параметров: Прямая -->
            <StackPanel x:Name="LinePanel" DockPanel.Dock="Top" Height="45" Orientation="Horizontal" Visibility="Collapsed">
                <Label Content="k" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="k_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="2" Margin="10,10,0,0"
                         Height="20" Width="50"/>
                <Label Content="b" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="b_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="-2" Margin="10,10,0,0"
                         Height="20" Width="50"/>
            </StackPanel>

            <!-- Панель параметров: Белый шум -->
            <StackPanel x:Name="NoisePanel" DockPanel.Dock="Top" Height="45" Orientation="Horizontal" Visibility="Collapsed">
                <Label Content="Размах" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="range_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="2" Margin="10,10,0,0"
                         Height="20" Width="50"/>
            </StackPanel>

            <!-- Нижние панели управления (без изменений) -->
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button Content="Сброс" HorizontalAlignment="Left" Width="70" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Clear"/>
                <Button Content="Удалить" HorizontalAlignment="Left" Width="70" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Click_Remove"/>
                <Button Content="Загрузить" HorizontalAlignment="Left" Width="70" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Load"/>
                <Button Content="Сохранить" HorizontalAlignment="Left" Width="70" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Write"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button Content="Сумма" HorizontalAlignment="Left" Width="70" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Click_Summ"/>
                <Button Content="Склейка" HorizontalAlignment="Left" Width="70" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Click_Concat"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="45" Orientation="Horizontal">
                <Label Content="Нов. част.(Гц)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="newFreq_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="100" Margin="10,10,0,0"
                         Height="20" Width="50"/>
                <Button Content="Изменить частоту" HorizontalAlignment="Left" Width="120" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Click_Resample"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button Content="Оф.фильтр" HorizontalAlignment="Right" Width="70" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Click_Offline"/>
                <Label Content="Окно(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="Window_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="0.5" Margin="10,10,0,0"
                         Height="20" Width="50"/>
                <Button Content="Он.фильтр" HorizontalAlignment="Left" Width="70" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Click_Online"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Label Content="upCut" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="upCut_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="-2" Margin="10,10,0,0"
                         Height="20" Width="50"/>
                <Label Content="downCut" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="downCut_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="-2" Margin="10,10,0,0"
                         Height="20" Width="50"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button Content="CutUp" HorizontalAlignment="Right" Width="70" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Click_CutUp"/>
                <Button Content="CutDown" HorizontalAlignment="Right" Width="70" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Click_CutDown"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button Content="CutUpAndDown" HorizontalAlignment="Right" Width="100" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Click_CutUpAndDown"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Button Content="Зашкалы" HorizontalAlignment="Left" Width="70" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Click_Analyze"/>
                <Button Content="Сохр.разм." HorizontalAlignment="Left" Width="70" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Write_Markup"/>
                <Button Content="Загр.разм." HorizontalAlignment="Left" Width="70" Margin="10,10,0,0"
                        VerticalAlignment="Top" Click="Button_Load_Markup"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Height="50" Orientation="Horizontal">
                <Label Content="Мин.:" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="min_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="-0.8" Margin="10,10,0,0"
                         Height="20" Width="40"/>
                <Label Content="Макс.:" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="max_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="0.8" Margin="10,10,0,0"
                         Height="20" Width="40"/>
                <Label Content="Длит.(с)" VerticalAlignment="Top" Margin="10,10,0,0" Padding="0,0,0,0" />
                <TextBox x:Name="duration_textBox" TextWrapping="Wrap" VerticalAlignment="Top" Text="0.2" Margin="10,10,0,0"
                         Height="20" Width="40"/>
            </StackPanel>
        </DockPanel>
        <!-- Панель анализа пересечений порога -->
        <DockPanel Grid.Column="2" Margin="5">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5,0,5">
                <Label Content="Порог:" VerticalAlignment="Center" Padding="0,0,5,0"/>
                <TextBox x:Name="ThresholdTextBox" Text="0" Width="70" Height="22" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Найти пересечения" Width="125" Height="24" Margin="0,0,5,0"
                Click="Button_Click_FindCrossings"/>
                <Button Content="Очистить маркеры" Width="100" Height="24"
                Click="Button_Click_ClearMarkers"/>
            </StackPanel>

            <TextBlock x:Name="SummaryTextBlock" DockPanel.Dock="Top" Margin="0,0,0,5"
               FontWeight="SemiBold" Text=""/>

            <ListBox x:Name="MarkerListBox"/>
        </DockPanel>
    </Grid>
</Window>